# ---- Core ----
# Public base URL of the app (used for Stripe redirects).
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://dollarsafe:dollarsafe@localhost:5432/dollarsafe
# 32+ random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- AI (Claude) ----
# Leave blank to run in mock mode (deterministic, offline answers that still use the real calculators).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Billing (Stripe) ----
# Leave blank to run in mock billing mode (upgrades apply instantly, no card needed; disabled in production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=

# ---- Automation ----
# Shared secret that Vercel Cron (or any scheduler) sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me
